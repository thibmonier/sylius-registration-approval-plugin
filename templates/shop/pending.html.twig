{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'tmonier_registration_approval.shop.pending.title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-5" data-test-tmonier-pending data-status="{{ status }}">
        <h1 class="h3 mb-3">{{ ('tmonier_registration_approval.shop.' ~ status ~ '.title')|trans }}</h1>
        <p>{{ ('tmonier_registration_approval.shop.' ~ status ~ '.message')|trans }}</p>
        <a href="{{ path('sylius_shop_logout') }}" class="btn btn-outline-primary">{{ 'sylius.ui.logout'|trans }}</a>
    </div>
{% endblock %}
